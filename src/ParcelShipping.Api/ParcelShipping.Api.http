@host = http://localhost:5080

### 200: fits Medium
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 250, "breadth": 350, "height": 180, "weight": 3.2 }

### 200: exactly Small's limits
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 200, "breadth": 300, "height": 150, "weight": 1 }

### 200: rotated parcel still fits Medium
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 400, "breadth": 300, "height": 200, "weight": 10 }

### 422: oversized
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 700, "breadth": 300, "height": 150, "weight": 5 }

### 422: overweight
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 100, "breadth": 100, "height": 100, "weight": 25.01 }

### 400: zero value
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 0, "breadth": 300, "height": 150, "weight": 5 }

### 400: negative value
POST {{host}}/api/packages/quote
Content-Type: application/json

{ "length": 200, "breadth": 300, "height": 150, "weight": -2 }
